# ---------------------------------------------------------------------------
# terraform.tfvars.example
# Cloud Infrastructure Deployment and DevOps Automation
#
# Copy this file to "terraform.tfvars" and fill in your own values.
# terraform.tfvars is git-ignored and should NEVER be committed,
# since it can contain values specific to your AWS account.
#
#   cp terraform.tfvars.example terraform.tfvars
# ---------------------------------------------------------------------------

aws_region       = "us-east-1"
instance_type    = "t2.micro"
key_pair_name    = "my-ec2-keypair"        # Must match an existing key pair in your AWS account
ami_id           = "ami-0e2c8caa4b6378d8c" # Verify the latest Ubuntu 22.04 LTS AMI for your region
instance_name    = "devops-flask-app-server"
allowed_ssh_cidr = "0.0.0.0/0"             # Restrict to your own IP in production, e.g. "203.0.113.10/32"
app_port         = 5000
